# Maintainer: Ishikudeska <83988568+Ishikudeska@users.noreply.github.com>

pkgname=scxtool-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="Star Citizen localization toolkit: ship, item and mission details in the game's own text"
arch=('x86_64')
url="https://github.com/Ishikudeska/Smart-Citizen-plus-plus"
license=('Apache-2.0' 'BSD-3-Clause' 'Zlib' 'MIT')
depends=('qt6-base' 'qt6-declarative' 'hicolor-icon-theme' 'gcc-libs' 'glibc')
makedepends=('git' 'cmake' 'ninja')
provides=("${pkgname%-git}")
conflicts=("${pkgname%-git}" 'smart-citizen-plus-plus-git')
# The package's name before the app was renamed from Smart Citizen++.
replaces=('smart-citizen-plus-plus-git')
# zstd, zlib and pugixml are built in statically, pinned to the same versions
# and hashes as cmake/Dependencies.cmake, so the build never touches the network.
source=("${pkgname%-git}::git+${url}.git"
        "https://github.com/facebook/zstd/releases/download/v1.5.7/zstd-1.5.7.tar.gz"
        "https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz"
        "https://github.com/zeux/pugixml/releases/download/v1.15/pugixml-1.15.tar.gz")
sha256sums=('SKIP'
            'eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3'
            '9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23'
            '655ade57fa703fb421c2eb9a0113b5064bddb145d415dd1f88c79353d90d511a')

pkgver() {
  cd "${pkgname%-git}"
  local version
  version=$(sed -n 's/^set(APP_VERSION *"\([^"]*\)").*/\1/p' cmake/AppIdentity.cmake)
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  # APP_UPDATE_REPO is emptied: updates come from pacman, not the in-app
  # check (which only knows the Windows installer).
  cmake -S "${pkgname%-git}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DAPP_UPDATE_REPO= \
    -DSC_BUILD_TOOLS=OFF \
    -DSC_USE_LLD=OFF \
    -DSC_LICENSE_DIR="share/licenses/${pkgname}" \
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
    -DFETCHCONTENT_SOURCE_DIR_ZSTD="${srcdir}/zstd-1.5.7" \
    -DFETCHCONTENT_SOURCE_DIR_ZLIB="${srcdir}/zlib-1.3.1" \
    -DFETCHCONTENT_SOURCE_DIR_PUGIXML="${srcdir}/pugixml-1.15"
  cmake --build build
}

check() {
  # Parity tests need the original Python app as a reference.
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure -LE parity
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
